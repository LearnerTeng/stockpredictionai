OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
ALPHA_VANTAGE_API_KEY=
DATABASE_URL=postgresql+psycopg://stockapp:stockapp_local@127.0.0.1:5432/stockpredictionai
STOCK_DATA_DB_PATH=backend/market_data/storage/market_data.db
TRADING_DB_PATH=backend/trading/storage/trading.db
IMAGE_SERVICE_BASE_URL=http://127.0.0.1:8001
ENABLE_WEB_MODEL_TRAINING=false
MODEL_REGISTRY_DIR=backend/storage/research
# Empty token allows loopback requests only. Remote deployments should use a
# private reverse proxy that injects the server-side token, never a VITE_* secret.
API_ACCESS_TOKEN=
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
