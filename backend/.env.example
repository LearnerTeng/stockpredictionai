OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# 独立新闻实验。将密钥保存在 Git 忽略的本地 .env 文件中。
# Independent news experiments. Keep keys in the Git-ignored local .env file.
NVIDIA_API_KEY=
LLM_DEEPSEEK_PROVIDER=nvidia
LLM_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_ULTRA_PROVIDER=nvidia
LLM_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# 各文本任务可单独切换提供方，向量嵌入配置独立。
# Text tasks can switch providers independently of the embedding configuration.
LLM_RESEARCH_PROVIDER=nvidia
LLM_EXPLANATION_PROVIDER=nvidia
LLM_SENTIMENT_PROVIDER=nvidia
ALPHA_VANTAGE_API_KEY=
DATABASE_URL=postgresql+psycopg://stockapp:stockapp_local@127.0.0.1:5432/stockpredictionai
STOCK_DATA_DB_PATH=backend/market_data/storage/market_data.db
TRADING_DB_PATH=backend/trading/storage/trading.db
IMAGE_SERVICE_BASE_URL=http://127.0.0.1:8001
ENABLE_WEB_MODEL_TRAINING=false
MODEL_REGISTRY_DIR=backend/storage/research
# 令牌为空时只接受本机环回请求。远程部署应由私有反向代理注入服务端令牌。
# An empty token allows loopback requests only. For remote deployments, inject the server-side token through a private reverse proxy.
# 服务端令牌不能放在 VITE_* 变量中。 Keep the server token out of VITE_* variables.
API_ACCESS_TOKEN=
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

LLM_ADVICE_PROVIDER=nvidia
LLM_ADVICE_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_REVIEW_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# SBI 基金导出目录，为每个 NISA 组合 ID 建立独立子目录。
# Private SBI fund export folder with one subfolder per NISA portfolio ID.
SBI_IMPORT_DIR=
# 留空时净值提醒仅显示在仪表盘。填写后使用上方 SMTP 设置发信。
# Leave blank for dashboard-only NAV alerts. Set recipients to send alerts with the SMTP settings above.
SBI_ALERT_RECIPIENTS=
